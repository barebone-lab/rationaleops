{
  "id": "decision-active-window-v1",
  "status": "CONFIRMED",
  "finding_type": "CONTRADICTORY_DECISION",
  "outcome": "CONFIRMED_RULE",
  "title": "Seven-day settlement grace period",
  "implements": {
    "dataset_urn": "urn:li:dataset:(urn:li:dataPlatform:postgres,analytics.revenue_daily,PROD)",
    "query_urn": "urn:li:query:revenue-daily-active-customers",
    "sql_fingerprint": "sha256:6012568173d2d9e60efa3b9e8e705fdc38dff7a0948f9ef9539008eef6753c63",
    "sql_fragment": "activity_at >= CURRENT_DATE - INTERVAL '37 DAYS'"
  },
  "intent": {
    "goal": "Prevent under-reporting caused by late card settlement",
    "canonical_rule": "Activity within 30 days plus a seven-day grace period for postpaid accounts"
  },
  "scope": {
    "includes": [
      "postpaid accounts"
    ],
    "excludes": [
      "prepaid accounts from the grace period"
    ]
  },
  "exceptions": [
    {
      "when": "billing_type = 'prepaid'",
      "behavior": "use a 30-day activity window",
      "evidence_refs": [
        "interview-active-window:turn-4"
      ]
    }
  ],
