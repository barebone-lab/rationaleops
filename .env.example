# Live LLM: any server implementing OpenAI Chat Completions
LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=replace-with-your-model-id
LLM_PROVIDER=OpenAI

# Compatibility defaults; most providers need no changes below.
LLM_JSON_MODE=auto
LLM_TIMEOUT_SECONDS=60

# Optional provider/model features. Uncomment only when supported.
# LLM_REASONING_EFFORT=high
# LLM_THINKING_ENABLED=true
# LLM_EXTRA_BODY_JSON={"thinking":{"type":"enabled"}}
# LLM_DEFAULT_HEADERS_JSON={"X-Custom-Header":"value"}
# LLM_DEFAULT_QUERY_JSON={"api-version":"provider-version"}
# LLM_MAX_TOKENS=1600
# LLM_MAX_TOKENS_PARAM=max_tokens

# Live DataHub OSS integration
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=

# Local API
RATIONALEOPS_DB_PATH=.rationaleops/state.db
RATIONALEOPS_HOST=127.0.0.1
RATIONALEOPS_PORT=8000
RATIONALEOPS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
